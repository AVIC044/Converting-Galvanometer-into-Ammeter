  m_Script: {fileID: 11500000, guid: d01fd2d64a9249049aaa77d5c12a82fe, type: 3}
  m_Name: Question2
  m_EditorClassIdentifier: 
  questionText: "2. A galvanometer of resistance G = 10092 and maximum current Ig=
    5x10 A needs to be converted into a voltmeter of range Vo = 10V. The resistance
    that needs to be connected in series is ______ \u03A9.\r\n"
  referenceImage: {fileID: 0}
  explanationText: "R = V\u2080 / Ig - G  \r\nR = 10 / 4 - 100  \r\nR = 19900 \u03A9"
  options:
  - 19500
  - 19900
  - 19220
  - 19950
  correctOptionIndex: 1
